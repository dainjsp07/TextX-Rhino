<#
  Shared build and packaging functions for Text X.
  Works in Windows PowerShell 5.1 and PowerShell 7.

    Import-Module (Join-Path $PSScriptRoot 'TextX.Build.psm1') -Force
#>

Set-StrictMode -Version 2.0

function Get-TextXRoot {
    return (Resolve-Path (Join-Path $PSScriptRoot '..')).Path
}

<#
  Reads VERSION and Directory.Build.props and returns the product information as a hashtable.
#>
function Get-TextXProduct {
    param([string]$Root = (Get-TextXRoot))
    $version = (Get-Content -Raw -Path (Join-Path $Root 'VERSION')).Trim()
    if ($version -notmatch '^\d+\.\d+\.\d+(-[0-9A-Za-z.\-]+)?$') { throw "VERSION must look like 1.2.3 or 1.2.3-beta.1 (found '$version')." }
    [xml]$props = Get-Content -Raw -Path (Join-Path $Root 'Directory.Build.props')
    $p = @{}
    foreach ($group in $props.Project.PropertyGroup) {
        foreach ($node in $group.ChildNodes) {
            if ($node.NodeType -ne 'Element') { continue }
            if ($node.GetAttribute('Condition')) { continue }   # derived values are computed below
            if (-not $p.ContainsKey($node.Name)) { $p[$node.Name] = $node.InnerText.Trim() }
        }
    }
    $repo = $p['TextXGitHubRepo']
    $feed = $p['TextXUpdateFeedUrl']
    if (-not $feed -and $repo) { $feed = "https://github.com/$repo/releases/latest/download/latest.json" }
    $site = $p['TextXWebsite']
    if (-not $site -and $repo) { $site = "https://github.com/$repo" }
    return @{
        Version        = $version
        VersionNumeric = ($version -split '-')[0]
        IsPreRelease   = $version.Contains('-')
        ProductName    = $p['TextXProductName']
        PackageName    = $p['TextXPackageName']
        Authors        = $p['TextXAuthors']
        Description    = $p['TextXDescription']
        GitHubRepo     = $repo
        UpdateFeedUrl  = $feed
        Website        = $site
    }
}

function ConvertTo-CSharpString([string]$s) {
    if ($null -eq $s) { return '""' }
    return '"' + ($s -replace '\\', '\\' -replace '"', '\"') + '"'
}

<#
  Writes the assembly attributes that "dotnet build" generates from Directory.Build.props
  (only needed for builds without the .NET SDK, see build-roslyn.ps1).
#>
function New-TextXAssemblyInfo {
    param([hashtable]$Product, [string]$Path)
    $date = (Get-Date).ToUniversalTime().ToString('yyyy-MM-dd')
    $lines = @(
        '// <auto-generated> by tools/TextX.Build.psm1 from VERSION and Directory.Build.props </auto-generated>',
        "[assembly: System.Reflection.AssemblyTitle($(ConvertTo-CSharpString $Product.ProductName))]",
        "[assembly: System.Reflection.AssemblyProduct($(ConvertTo-CSharpString $Product.ProductName))]",
        "[assembly: System.Reflection.AssemblyCompany($(ConvertTo-CSharpString $Product.Authors))]",
        "[assembly: System.Reflection.AssemblyDescription($(ConvertTo-CSharpString $Product.Description))]",
        "[assembly: System.Reflection.AssemblyCopyright($(ConvertTo-CSharpString ('Copyright (c) ' + $Product.Authors + '. MIT License.')))]",
        "[assembly: System.Reflection.AssemblyVersion(""$($Product.VersionNumeric).0"")]",
        "[assembly: System.Reflection.AssemblyFileVersion(""$($Product.VersionNumeric).0"")]",
        "[assembly: System.Reflection.AssemblyInformationalVersion(""$($Product.Version)"")]",
        "[assembly: System.Reflection.AssemblyMetadata(""TextX.PackageName"", $(ConvertTo-CSharpString $Product.PackageName))]",
        "[assembly: System.Reflection.AssemblyMetadata(""TextX.UpdateFeedUrl"", $(ConvertTo-CSharpString $Product.UpdateFeedUrl))]",
        "[assembly: System.Reflection.AssemblyMetadata(""TextX.Website"", $(ConvertTo-CSharpString $Product.Website))]",
        "[assembly: System.Reflection.AssemblyMetadata(""TextX.GitHubRepo"", $(ConvertTo-CSharpString $Product.GitHubRepo))]",
        "[assembly: System.Reflection.AssemblyMetadata(""TextX.BuildDate"", ""$date"")]"
    )
    $dir = Split-Path -Parent $Path
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }
    [System.IO.File]::WriteAllLines($Path, $lines, (New-Object System.Text.UTF8Encoding($false)))
}

<#
  Returns the release notes of one version from CHANGELOG.md ("## [1.2.0] - 2026-11-02" sections).
#>
function Get-TextXReleaseNotes {
    param([string]$Version, [string]$Root = (Get-TextXRoot))
    $path = Join-Path $Root 'CHANGELOG.md'
    if (-not (Test-Path $path)) { return '' }
    $lines = Get-Content -Path $path -Encoding UTF8
    $out = New-Object System.Collections.Generic.List[string]
    $inside = $false
    foreach ($l in $lines) {
        if ($l -match '^## \[(.+?)\]') {
            if ($inside) { break }
            if ($Matches[1] -eq $Version) { $inside = $true; continue }
        }
        elseif ($inside) { $out.Add($l) }
    }
    return (($out -join "`n").Trim())
}

function Add-ZipEntryFromFile {
    param($Zip, [string]$File, [string]$EntryName)
    $entry = $Zip.CreateEntry($EntryName.Replace('\', '/'), [System.IO.Compression.CompressionLevel]::Optimal)
    $in = [System.IO.File]::OpenRead($File)
    try {
        $out = $entry.Open()
        try { $in.CopyTo($out) } finally { $out.Dispose() }
    }
    finally { $in.Dispose() }
}

<#
  Creates a zip file from a list of @{ File = <path>; Name = <entry name> } items.
  Entry names always use '/' separators (Rhino and every unzip tool read them correctly).
#>
function New-TextXZip {
    param([string]$Path, [object[]]$Items)
    Add-Type -AssemblyName System.IO.Compression
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if (Test-Path $Path) { Remove-Item $Path -Force }
    $stream = [System.IO.File]::Open($Path, [System.IO.FileMode]::CreateNew)
    try {
        $zip = New-Object System.IO.Compression.ZipArchive($stream, [System.IO.Compression.ZipArchiveMode]::Create)
        try {
            foreach ($i in $Items) { Add-ZipEntryFromFile -Zip $zip -File $i.File -EntryName $i.Name }
        }
        finally { $zip.Dispose() }
    }
    finally { $stream.Dispose() }
}

function Get-TextXSha256([string]$Path) {
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $fs = [System.IO.File]::OpenRead($Path)
    try { return ([System.BitConverter]::ToString($sha.ComputeHash($fs))).Replace('-', '').ToLowerInvariant() }
    finally { $fs.Dispose(); $sha.Dispose() }
}

Export-ModuleMember -Function Get-TextXRoot, Get-TextXProduct, New-TextXAssemblyInfo, Get-TextXReleaseNotes, New-TextXZip, Get-TextXSha256
